#!name=Wink AI VIP & Auto-GID (Standalone)
#!desc=Chỉ 1 file Module duy nhất không cần file .js rời. Tự động cấp GID mới & Quota VIP không giới hạn cho Wink.
#!author=Weat
#!system=iOS

[MITM]
hostname = %APPEND% *.meitu.com, api.account.meitu.com, api.data.meitu.com, api-winkcut.meitu.com, titan-h5.meitu.com, pro.meitu.com

[Script]
# 1. Tự động sinh GID & DeviceID ngẫu nhiên cho từng Request
Wink_Req = type=http-request,pattern=^https?:\/\/.*\.meitu\.com\/.*,script-path="data:text/javascript;base64,",requires-body=true,max-size=1048576

# 2. Bơm hạn mức Quota & mở khóa VIP không giới hạn cho Response
Wink_Res = type=http-response,pattern=^https?:\/\/.*\.meitu\.com\/.*(rights|quota|limit|vip|subscription).*,script-path="data:text/javascript;base64,",requires-body=true,max-size=1048576
